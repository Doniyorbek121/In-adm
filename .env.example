# ==== Server ====
PORT=3000

# Webhook tekshiruvi uchun o'zingiz o'ylab topgan maxfiy so'z
# (Meta Developer panelda webhook sozlashda shuni kiritasiz)
VERIFY_TOKEN=mening-maxfiy-tokenim

# Meta App maxfiy kaliti (webhook imzosini tekshirish uchun)
APP_SECRET=

# ==== Instagram / Facebook ====
# Facebook sahifangizning Page Access Token'i
# (Instagram Business akkaunt shu sahifaga ulangan bo'lishi kerak)
PAGE_ACCESS_TOKEN=

# Instagram Business akkaunt ID (o'z kommentlaringizga javob bermaslik uchun)
IG_USER_ID=

# ==== WhatsApp Cloud API ====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Graph API versiyasi
GRAPH_API_VERSION=v21.0

# ==== AI ====
# Ikkala provayderdan birini tanlang (ikkalasi berilsa Gemini ustun).
# Hech biri berilmasa bot AI'siz, faqat rules.json dagi kalit so'z
# qoidalari bilan ishlaydi.

# Gemini: https://aistudio.google.com/apikey dan olinadi (bepul tarif bor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude: https://platform.claude.com dan olinadi
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
