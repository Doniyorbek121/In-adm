# ==== Server ====
PORT=3000

# Webhook tekshiruvi uchun o'zingiz o'ylab topgan maxfiy so'z
# (Meta Developer panelda webhook sozlashda shuni kiritasiz)
VERIFY_TOKEN=mening-maxfiy-tokenim

# Meta App maxfiy kaliti (webhook imzosini tekshirish uchun)
APP_SECRET=

# Graph API versiyasi
GRAPH_API_VERSION=v21.0

# Admin (dasturchi) email'lari — bu hisoblar barcha bizneslarning
# Meta tokenlarini boshqara oladi (/admin panel). Vergul bilan bir nechta.
# Avval shu email bilan ro'yxatdan o'ting, keyin admin bo'lasiz.
ADMIN_EMAILS=admin@example.com

# ==== AI — platforma kaliti (dasturchi kiritadi) ====
# Bu kalit butun platforma uchun ishlaydi — tadbirkorlar o'z kalitini
# kiritmaydi. (Kerak bo'lsa, admin bitta biznesga alohida kalit bera oladi.)

# Gemini: https://aistudio.google.com/apikey (bepul tarif bor)
# Ovoz/rasm/video tahlili uchun Gemini kerak.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude (ixtiyoriy muqobil): https://platform.claude.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
