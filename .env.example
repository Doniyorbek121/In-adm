# ==== Server ====
PORT=3000

# Webhook tekshiruvi uchun o'zingiz o'ylab topgan maxfiy so'z
# (Meta Developer panelda webhook sozlashda shuni kiritasiz)
VERIFY_TOKEN=mening-maxfiy-tokenim

# Meta App maxfiy kaliti (webhook imzosini tekshirish uchun)
APP_SECRET=

# Graph API versiyasi
GRAPH_API_VERSION=v21.0

# ==== AI (ixtiyoriy umumiy kalitlar) ====
# Har bir foydalanuvchi o'z Gemini kalitini veb-panelda kiritadi.
# Quyidagilar berilsa — kalit kiritmagan foydalanuvchilar uchun
# umumiy (platforma) kaliti sifatida ishlaydi.

# Gemini: https://aistudio.google.com/apikey (bepul tarif bor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude: https://platform.claude.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
